PINECONE_API_KEY: "your-pinecone-api-key"
PINECONE_HOST: "your-pinecone-host"
PINECONE_INDEX: "your-pinecone-index"
GEMINI_API_KEY: "your-gemini-api-key"
GEMINI_EMBEDDING_MODEL: "gemini-embedding-001"
GEMINI_EMBEDDING_DIM: "1536"
GEMINI_CHAT_MODEL: "gemini-2.5-pro"
GEMINI_LIVE_MODEL: "gemini-2.5-flash-native-audio-latest"
GEMINI_LIVE_RESPONSE_MODALITIES: "AUDIO"
GEMINI_FALLBACK_MODELS: ""
GEMINI_SAFETY: "block_only_high"
DEMO_CONTEXT_ENABLED: "false"
DEMO_CONTEXT_FILE: "app/demo_context.txt"
R2_ACCOUNT_ID: "your-r2-account-id"
R2_ACCESS_KEY_ID: "your-r2-access-key-id"
R2_SECRET_ACCESS_KEY: "your-r2-secret-access-key"
R2_BUCKET: "your-r2-bucket"
R2_ENDPOINT: "https://<account-id>.r2.cloudflarestorage.com/<bucket>"
SERVICE_TOKEN: "your-service-token"
TRANSCRIBE_WS_SECRET: "your-strong-random-secret"
